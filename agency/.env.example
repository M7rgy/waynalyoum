# Copy this file to ".env" (same folder) and fill in. Never share .env.
ANTHROPIC_API_KEY=sk-ant-...
# Only needed if your key is NOT scoped to a workspace (error mentions anthropic-workspace-id)
ANTHROPIC_WORKSPACE_ID=
# Optional — or log in once with:  postiz auth:login
POSTIZ_API_KEY=
# Optional — only if you self-host Postiz
# POSTIZ_API_URL=https://your-postiz-domain/api
